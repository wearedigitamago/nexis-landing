{
  "name": "nexis-landing",
  "version": "1.1.3",
  "private": true,
  "description": "NEXIS landing page (static). The only build step is the Tailwind stylesheet.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./assets/css/site.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./assets/css/site.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "tailwindcss": "3.4.19"
  }
}
